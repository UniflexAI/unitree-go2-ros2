<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Idealized stereo model for simulation:
         - resolution: 848x480
         - horizontal FOV: 90 deg
         - intrinsics: fx = fy = 424, cx = 424, cy = 240
         - stereo baseline: 0.05 m (left/right offsets are +/-0.025 m in Y)
         - topic naming follows tinynav RealSense expectations where practical -->
    <joint name="camera_mount_joint" type="fixed">
        <origin xyz="0.245 0.0 0.045" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>

    <link name="camera_link">
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
        </inertial>
        <visual name="camera_body_visual">
            <origin xyz="0.03 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.12 0.03 0.04"/>
            </geometry>
            <material>
                <ambient>0.95 0.65 0.1 1</ambient>
                <diffuse>0.95 0.65 0.1 1</diffuse>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.09 0.025 0.03"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_depth_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="camera_link"/>
        <child link="camera_depth_frame"/>
    </joint>
    <link name="camera_depth_frame"/>

    <joint name="camera_depth_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
        <parent link="camera_depth_frame"/>
        <child link="camera_depth_optical_frame"/>
    </joint>
    <link name="camera_depth_optical_frame"/>

    <joint name="camera_color_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="camera_link"/>
        <child link="camera_color_frame"/>
    </joint>
    <link name="camera_color_frame"/>

    <joint name="camera_color_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
        <parent link="camera_color_frame"/>
        <child link="camera_color_optical_frame"/>
    </joint>
    <link name="camera_color_optical_frame"/>

    <joint name="camera_left_ir_joint" type="fixed">
        <origin xyz="0 0.025 0" rpy="0 0 0"/>
        <parent link="camera_link"/>
        <child link="camera_left_ir_frame"/>
    </joint>
    <link name="camera_left_ir_frame">
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <visual name="camera_left_x_axis_visual">
            <origin xyz="0.5 0 0" rpy="0 1.57079632679 0"/>
            <geometry>
                <cylinder radius="0.008" length="1.0"/>
            </geometry>
            <material>
                <ambient>1 0 0 1</ambient>
                <diffuse>1 0 0 1</diffuse>
            </material>
        </visual>
        <visual name="camera_left_y_axis_visual">
            <origin xyz="0 0.5 0" rpy="1.57079632679 0 0"/>
            <geometry>
                <cylinder radius="0.008" length="1.0"/>
            </geometry>
            <material>
                <ambient>0 1 0 1</ambient>
                <diffuse>0 1 0 1</diffuse>
            </material>
        </visual>
        <visual name="camera_left_z_axis_visual">
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.008" length="1.0"/>
            </geometry>
            <material>
                <ambient>0 0 1 1</ambient>
                <diffuse>0 0 1 1</diffuse>
            </material>
        </visual>
    </link>

    <joint name="camera_left_ir_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
        <parent link="camera_left_ir_frame"/>
        <child link="camera_left_ir_optical_frame"/>
    </joint>
    <link name="camera_left_ir_optical_frame"/>

    <joint name="camera_right_ir_joint" type="fixed">
        <origin xyz="0 -0.025 0" rpy="0 0 0"/>
        <parent link="camera_link"/>
        <child link="camera_right_ir_frame"/>
    </joint>
    <link name="camera_right_ir_frame">
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <visual name="camera_right_x_axis_visual">
            <origin xyz="0.5 0 0" rpy="0 1.57079632679 0"/>
            <geometry>
                <cylinder radius="0.008" length="1.0"/>
            </geometry>
            <material>
                <ambient>1 0 0 1</ambient>
                <diffuse>1 0 0 1</diffuse>
            </material>
        </visual>
        <visual name="camera_right_y_axis_visual">
            <origin xyz="0 0.5 0" rpy="1.57079632679 0 0"/>
            <geometry>
                <cylinder radius="0.008" length="1.0"/>
            </geometry>
            <material>
                <ambient>0 1 0 1</ambient>
                <diffuse>0 1 0 1</diffuse>
            </material>
        </visual>
        <visual name="camera_right_z_axis_visual">
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.008" length="1.0"/>
            </geometry>
            <material>
                <ambient>0 0 1 1</ambient>
                <diffuse>0 0 1 1</diffuse>
            </material>
        </visual>
    </link>

    <joint name="camera_right_ir_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
        <parent link="camera_right_ir_frame"/>
        <child link="camera_right_ir_optical_frame"/>
    </joint>
    <link name="camera_right_ir_optical_frame"/>

    <joint name="camera_imu_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="camera_link"/>
        <child link="camera_imu_frame"/>
    </joint>
    <link name="camera_imu_frame">
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
    </link>

    <gazebo reference="camera_color_frame">
        <sensor name="camera_color" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <topic>camera/camera/color/image_raw</topic>
            <camera_info_topic>camera/camera/color/camera_info</camera_info_topic>
            <ignition_frame_id>camera_color_optical_frame</ignition_frame_id>
            <camera>
                <horizontal_fov>1.57079632679</horizontal_fov>
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="camera_depth_frame">
        <sensor name="camera_depth" type="depth_camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <topic>camera/camera/depth/image_rect_raw</topic>
            <camera_info_topic>camera/camera/depth/camera_info</camera_info_topic>
            <ignition_frame_id>camera_depth_optical_frame</ignition_frame_id>
            <camera>
                <horizontal_fov>1.57079632679</horizontal_fov>
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="camera_left_ir_frame">
        <sensor name="camera_left_ir" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <topic>camera/camera/infra1/image_rect_raw</topic>
            <camera_info_topic>camera/camera/infra1/camera_info</camera_info_topic>
            <ignition_frame_id>camera_left_ir_optical_frame</ignition_frame_id>
            <camera>
                <horizontal_fov>1.57079632679</horizontal_fov>
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>L8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="camera_right_ir_frame">
        <sensor name="camera_right_ir" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <topic>camera/camera/infra2/image_rect_raw</topic>
            <camera_info_topic>camera/camera/infra2/camera_info</camera_info_topic>
            <ignition_frame_id>camera_right_ir_optical_frame</ignition_frame_id>
            <camera>
                <horizontal_fov>1.57079632679</horizontal_fov>
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>L8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="camera_imu_frame">
        <sensor name="camera_imu_sensor" type="imu">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>200</update_rate>
            <topic>camera/camera/imu</topic>
            <ignition_frame_id>camera_imu_frame</ignition_frame_id>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
                </linear_acceleration>
            </imu>
            <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
        </sensor>
    </gazebo>
</robot>
